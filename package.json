{
  "name": "dsh-jinhsi-skin",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "今汐·洄天溯海 —— DeepSeek Harness Web GUI 的《鸣潮》今汐皮肤插件：把皮肤装进用户皮肤目录。想用壁纸时，可选依赖皮肤中心（@linxin666/dsh-client-ui-skin-center）提供渲染与壁纸能力。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "skin",
    "theme",
    "wallpaper",
    "wuthering-waves",
    "jinhsi"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mauit06/dsh-jinhsi-skin.git"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skin",
    "tools/asset-sources.json",
    "tools/verify-standalone.mjs",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@linxin666/dsh-client-ui-skin-center": "^0.3.23"
  },
  "peerDependenciesMeta": {
    "@linxin666/dsh-client-ui-skin-center": {
      "optional": true
    }
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
